  {
    "function": {
      "name": "record_exercise",
      "description": "用户明确已完成运动或要求记录时使用；计划或建议禁止记录。本机自动保存，聊天卡片可编辑删除。缺信息先问。",
      "parameters": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "date": {
            "description": "运动日期 YYYY-MM-DD，省略今天",
            "type": "string"
          },
          "minutes": {
            "description": "时长，1至1440分钟",
            "type": "integer"
          },
          "name": {
            "description": "实际运动名称；估算支持散步、快走、慢跑，不能把未知运动映射为这些类型",
            "type": "string"
          },
          "time": {
            "description": "运动时间 HH:mm，省略当前时间",
            "type": "string"
          },
          "active_kcal": {
            "description": "可选：用户明确提供的活动千卡，0至10000，不含静息；不允许模型自编数值。没有则省略，由本机MET估算",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "minutes"
        ]
      }
    },
    "type": "function"
  },
  {
    "function": {
      "name": "query_exercises",
      "description": "查询1至31天本地运动记录，最多50条；不猜已记录数据",
      "parameters": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "from": {
            "description": "开始日期 YYYY-MM-DD",
            "type": "string"
          },
          "to": {
            "description": "结束日期 YYYY-MM-DD",
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ]
      }
    },
    "type": "function"
  },
  {
    "function": {
      "name": "query_progress",
      "description": "汇总1至31天全部已确认餐饮、运动和当时身体数据；七天总结及营养素查询优先使用，包含每日蛋白质、碳水、脂肪的已知量、缺项数和参考量，以及缺失天数和本机算好的差值、脂肪能量当量",
      "parameters": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "from": {
            "description": "开始日期 YYYY-MM-DD",
            "type": "string"
          },
          "to": {
            "description": "结束日期 YYYY-MM-DD",
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ]
      }
    },
    "type": "function"
  },
  {
    "type": "function",
    "function": {
      "name": "query_settings",
      "description": "读取当前身体资料、活动等级、按日期覆盖及可编辑设置；不会返回API Key。修改前先查询。",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_profile",
      "description": "用户明确要求修改身体资料或每日默认活动时使用，仅传用户要改的字段。从今天生效，生成确认卡，不能默默改历史。",
      "parameters": {
        "type": "object",
        "properties": {
          "sex": {
            "type": "string",
            "description": "性别",
            "enum": [
              "male",
              "female"
            ]
          },
          "age": {
            "type": "integer",
            "description": "年龄",
            "minimum": 1,
            "maximum": 120
          },
          "height": {
            "type": "number",
            "description": "身高cm",
            "minimum": 80,
            "maximum": 250
          },
          "weight": {
            "type": "number",
            "description": "体重kg",
            "minimum": 15,
            "maximum": 350
          },
          "activity": {
            "type": "string",
            "description": "活动级别；全天活动含运动，不能重复加运动热量",
            "enum": [
              "sedentary",
              "light",
              "moderate",
              "high"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "set_daily_activity",
      "description": "仅修改用户指定某一天的活动等级；不修改每天默认。default恢复当天适用默认。先query_settings，生成确认卡。",
      "parameters": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "YYYY-MM-DD，不能未来"
          },
          "activity": {
            "type": "string",
            "description": "当天活动",
            "enum": [
              "sedentary",
              "light",
              "moderate",
              "high",
              "default"
            ]
          }
        },
        "required": [
          "date",
          "activity"
        ],
        "additionalProperties": false
      }
    }
  },
  {
