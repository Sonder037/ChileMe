[
  {
    "type": "function",
    "function": {
      "name": "ask_user",
      "description": "缺少影响正确记录的关键信息时，提供一个简短问题和2至4个可点击选项。等待用户选择后继续；不代替餐饮确认，不与记录工具同时调用。",
      "parameters": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "description": "一个必要问题，最多120字",
            "maxLength": 120
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "description": "简短、互不重复的答案，最多40字",
              "maxLength": 40
            }
          }
        },
        "required": [
          "question",
          "options"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "function": {
      "name": "query_meals",
      "description": "按日期查询本地餐饮、逐项蛋白质/碳水/脂肪克数及未确认估算草稿，state区分。编辑前先查询取得真实meal_id；一次最多31天、20条，truncated时用next_offset继续查询。",
      "parameters": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "offset": {
            "description": "省略从0开始；继续查询时使用上次返回的next_offset，保持日期范围相同",
            "type": "integer",
            "minimum": 0
          },
          "from": {
            "description": "起始日期 YYYY-MM-DD",
            "type": "string"
          },
          "to": {
            "description": "结束日期 YYYY-MM-DD",
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ]
      }
    },
    "type": "function"
  },
  {
    "function": {
      "name": "record_meal",
      "description": "用户明确说已吃/喝或要求记录时创建待确认草稿。仅讨论建议、食谱或假设时禁止记录。一次会话最多创建或编辑一餐。",
      "parameters": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "date": {
            "description": "用餐日期 YYYY-MM-DD，省略为今天。用户提到昨天等相对日期时必须换算。",
            "type": "string"
          },
          "meal_type": {
            "description": "优先用户明确餐次；不明确则省略，由本机按时间推断。可选早餐、午餐、晚餐、夜宵、加餐。",
            "type": "string"
          },
          "time": {
            "description": "用餐时间 HH:mm；优先用户明确时间，省略为当前设备时间。",
            "type": "string"
          },
          "items": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "properties": {
                "kcal": {
                  "maximum": 10000,
                  "description": "该份食物的估算热量，不是每100克；无法估算先询问",
                  "type": "integer",
                  "minimum": 0
                },
                "unit": {
                  "description": "固体优先g，液体优先ml；包装数量可用份、个、杯、碗、瓶、盒、片",
                  "type": "string",
                  "enum": [
                    "g",
                    "ml",
                    "份",
                    "个",
                    "杯",
                    "碗",
                    "瓶",
                    "盒",
                    "片"
                  ]
                },
                "quantity": {
                  "maximum": 10000,
                  "description": "实际摄入份量，数值与单位分开；未知为null，不把ml当作g；0只用于未摄入该项且kcal为0",
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "name": {
                  "description": "食物名；不能编造不认识的食品",
                  "type": "string"
                },
                "category": {
                  "description": "食品分类；纯牛奶、酸奶属于奶类；豆浆、豆腐属于豆类；茶、咖啡属于饮品。不确定选其他",
                  "type": "string",
                  "enum": [
                    "主食",
                    "蔬菜",
                    "水果",
                    "肉蛋鱼",
                    "奶类",
                    "豆类",
                    "饮品",
                    "零食",
                    "其他"
                  ]
                },
                "nutrients": {
                  "type": "object",
                  "properties": {
                    "protein_g": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 2500,
                      "description": "整份蛋白质克数，未知为null"
                    },
                    "carbs_g": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 2500,
                      "description": "整份总碳水克数，不是糖，未知为null"
                    },
                    "fat_g": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 2500,
                      "description": "整份脂肪克数，未知为null"
                    }
                  },
                  "required": [
                    "protein_g",
                    "carbs_g",
                    "fat_g"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "quantity",
                "unit",
                "kcal",
                "category"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      }
    },
    "type": "function"
  },
