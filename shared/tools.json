          "chat_model": {
            "type": "string",
            "description": "聊天模型名",
            "maxLength": 150
          },
          "vision_model": {
            "type": "string",
            "description": "视觉模型名",
            "maxLength": 150
          },
          "memory_enabled": {
            "type": "boolean",
            "description": "是否记录本地记忆"
          },
          "include_memory": {
            "type": "boolean",
            "description": "发送时是否附带记忆"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "query_memories",
      "description": "仅用户主动要求查看或修改记忆时查询。关键词检索最多20条，不自动遍历全部记忆。",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
